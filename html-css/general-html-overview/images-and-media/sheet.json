{
  "title": "Images and Media",
  "subtitle": "What alt text is for, and what it is not",
  "kind": "read",
  "language": "html",
  "seed": "images-and-media",
  "code": [
    { "text": "<!-- alt says what the image is for, not what it holds -->", "role": "comment" },
    { "text": "<img src=\"chart.png\" width=\"800\" height=\"400\"", "role": "identifier" },
    { "text": "     alt=\"Orders doubled between March and June\">", "role": "string" },
    { "text": "" },
    { "text": "<!-- Decorative only: an empty alt, never a missing one -->", "role": "comment" },
    { "text": "<img src=\"rule.svg\" alt=\"\" width=\"600\" height=\"2\">", "role": "identifier" },
    { "text": "" },
    { "text": "<!-- The browser picks the file; sizes says how wide -->", "role": "comment" },
    { "text": "<img src=\"hero-800.jpg\" alt=\"A harbour at dawn\"", "role": "identifier" },
    { "text": "     srcset=\"hero-400.jpg 400w, hero-800.jpg 800w\"", "role": "string" },
    { "text": "     sizes=\"(max-width: 600px) 100vw, 800px\">", "role": "string" },
    { "text": "" },
    { "text": "<!-- picture chooses a format; img stays the fallback -->", "role": "comment" },
    { "text": "<picture>", "role": "keyword" },
    { "text": "  <source srcset=\"shot.webp\" type=\"image/webp\">", "role": "identifier" },
    { "text": "  <img src=\"shot.jpg\" alt=\"The finished sheet\" width=\"600\"", "role": "identifier" },
    { "text": "       height=\"600\">", "role": "string" },
    { "text": "</picture>", "role": "keyword" },
    { "text": "" },
    { "text": "<video controls width=\"640\" poster=\"still.jpg\">", "role": "identifier" },
    { "text": "  <source src=\"demo.webm\" type=\"video/webm\">", "role": "identifier" },
    { "text": "  <track kind=\"captions\" src=\"demo.vtt\" default>", "role": "identifier" },
    { "text": "  This browser cannot play the video." },
    { "text": "</video>", "role": "keyword" }
  ]
}
