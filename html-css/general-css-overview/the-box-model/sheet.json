  "code": [
    { "text": "/* border-box counts padding and border inside the width */", "role": "comment" },
    { "text": "*,", "role": "keyword" },
    { "text": "*::before,", "role": "keyword" },
    { "text": "*::after {", "role": "keyword" },
    { "text": "  box-sizing: border-box;", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": ".panel {", "role": "keyword" },
    { "text": "  /* Four values read clockwise from the top */", "role": "comment" },
    { "text": "  padding: 16px 24px 16px 24px;", "role": "identifier" },
    { "text": "  border: 2px solid #4dae51;", "role": "identifier" },
    { "text": "  margin: 0 auto;", "role": "identifier" },
    { "text": "  width: 320px;", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "/* Margins collapse between siblings, padding never does */", "role": "comment" },
    { "text": ".panel + .panel {", "role": "keyword" },
    { "text": "  margin-top: 24px;", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "/* An outline is drawn outside the box and takes no space */", "role": "comment" },
    { "text": ".panel:focus-visible {", "role": "keyword" },
    { "text": "  outline: 3px solid #4dae51;", "role": "identifier" },
    { "text": "  outline-offset: 2px;", "role": "identifier" },
    { "text": "}", "role": "keyword" }
  ]
}
