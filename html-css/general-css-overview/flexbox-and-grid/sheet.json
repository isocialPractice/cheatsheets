    { "text": "/* Flex lays out one axis and lets the other wrap */", "role": "comment" },
    { "text": ".toolbar {", "role": "keyword" },
    { "text": "  display: flex;", "role": "identifier" },
    { "text": "  flex-wrap: wrap;", "role": "identifier" },
    { "text": "  justify-content: space-between;", "role": "identifier" },
    { "text": "  align-items: center;", "role": "identifier" },
    { "text": "  gap: 16px;", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": ".toolbar > .spacer {", "role": "keyword" },
    { "text": "  /* grow, shrink, basis - in that order */", "role": "comment" },
    { "text": "  flex: 1 1 auto;", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "/* Grid lays out both axes at once */", "role": "comment" },
    { "text": ".gallery {", "role": "keyword" },
    { "text": "  display: grid;", "role": "identifier" },
    { "text": "  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));", "role": "identifier" },
    { "text": "  gap: 24px;", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": ".layout {", "role": "keyword" },
    { "text": "  display: grid;", "role": "identifier" },
    { "text": "  grid-template-areas:", "role": "identifier" },
    { "text": "    \"head head\"", "role": "string" },
    { "text": "    \"body side\";", "role": "string" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": ".layout > .side {", "role": "keyword" },
    { "text": "  grid-area: side;", "role": "identifier" },
    { "text": "}", "role": "keyword" }
  ]
