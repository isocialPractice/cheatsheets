{
  "title": "URL and Query Strings",
  "subtitle": "Reading and writing an address without string surgery",
  "kind": "embed",
  "language": "javascript",
  "seed": "url-and-query-strings",
  "code": [
    { "text": "// A URL parses once, and every part reads off it after", "role": "comment" },
    { "text": "const here = new URL(\"https://example.com/shop?page=2\");", "role": "identifier" },
    { "text": "report(here.pathname);", "role": "identifier" },
    { "text": "report(here.hash);", "role": "identifier" },
    { "text": "" },
    { "text": "// A relative address needs the base it is relative to", "role": "comment" },
    { "text": "const next = new URL(\"/shop/page/3\", here);", "role": "identifier" },
    { "text": "" },
    { "text": "// searchParams encodes for you, so never build a query", "role": "comment" },
    { "text": "const query = new URLSearchParams();", "role": "identifier" },
    { "text": "query.set(\"q\", \"oak & ash\");", "role": "identifier" },
    { "text": "query.set(\"page\", \"2\");", "role": "identifier" },
    { "text": "report(query.toString());", "role": "identifier" },
    { "text": "" },
    { "text": "// A key may repeat, and get returns the first of them", "role": "comment" },
    { "text": "query.append(\"tag\", \"sale\");", "role": "identifier" },
    { "text": "query.append(\"tag\", \"new\");", "role": "identifier" },
    { "text": "report(query.getAll(\"tag\").length);", "role": "identifier" },
    { "text": "" },
    { "text": "// The parser is the one the address bar itself uses", "role": "comment" },
    { "text": "try {", "role": "keyword" },
    { "text": "  new URL(\"not an address\");", "role": "identifier" },
    { "text": "} catch (error) {", "role": "keyword" },
    { "text": "  warn(\"that string is not a URL\");", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "// Writing the query back onto it is one assignment", "role": "comment" },
    { "text": "here.search = query.toString();", "role": "identifier" },
    { "text": "report(here.href);", "role": "identifier" }
  ]
}
