{
  "title": "Element Observers",
  "subtitle": "Watching visibility, size and the tree without polling",
  "kind": "embed",
  "language": "javascript",
  "seed": "element-observers",
  "code": [
    { "text": "// IntersectionObserver reports a target entering view", "role": "comment" },
    { "text": "const seen = new IntersectionObserver((entries) => {", "role": "identifier" },
    { "text": "  for (const entry of entries) {", "role": "keyword" },
    { "text": "    if (entry.isIntersecting) {", "role": "keyword" },
    { "text": "      entry.target.classList.add(\"shown\");", "role": "identifier" },
    { "text": "    }", "role": "keyword" },
    { "text": "  }", "role": "keyword" },
    { "text": "});", "role": "keyword" },
    { "text": "seen.observe(document.querySelector(\"#panel\"));", "role": "identifier" },
    { "text": "" },
    { "text": "// A threshold of 0.5 waits for half of it to be in view", "role": "comment" },
    { "text": "const half = { threshold: 0.5 };", "role": "identifier" },
    { "text": "" },
    { "text": "// ResizeObserver measures the element, not the window", "role": "comment" },
    { "text": "const sized = new ResizeObserver((entries) => {", "role": "identifier" },
    { "text": "  for (const entry of entries) {", "role": "keyword" },
    { "text": "    report(entry.contentRect.width);", "role": "identifier" },
    { "text": "  }", "role": "keyword" },
    { "text": "});", "role": "keyword" },
    { "text": "" },
    { "text": "// MutationObserver watches the tree for the changes named", "role": "comment" },
    { "text": "const changed = new MutationObserver((records) => {", "role": "identifier" },
    { "text": "  report(records.length);", "role": "identifier" },
    { "text": "});", "role": "keyword" },
    { "text": "changed.observe(list, { childList: true, subtree: true });", "role": "identifier" },
    { "text": "" },
    { "text": "// Every observer holds its targets until disconnected", "role": "comment" },
    { "text": "seen.disconnect();", "role": "identifier" },
    { "text": "sized.disconnect();", "role": "identifier" },
    { "text": "changed.disconnect();", "role": "identifier" }
  ]
}
