{
  "title": "Clipboard and Dialogs",
  "subtitle": "A modal the browser owns, and a copy it must be asked for",
  "kind": "embed",
  "language": "javascript",
  "seed": "clipboard-and-dialog",
  "code": [
    { "text": "// A dialog opens modally, and the browser draws the backdrop", "role": "comment" },
    { "text": "const box = document.querySelector(\"dialog\");", "role": "identifier" },
    { "text": "box.showModal();", "role": "identifier" },
    { "text": "" },
    { "text": "// Escape closes it, so close fires either way", "role": "comment" },
    { "text": "box.addEventListener(\"close\", () => {", "role": "identifier" },
    { "text": "  report(box.returnValue);", "role": "identifier" },
    { "text": "});", "role": "keyword" },
    { "text": "" },
    { "text": "// A form inside it closes the dialog and sets the value", "role": "comment" },
    { "text": "const form = box.querySelector(\"form\");", "role": "identifier" },
    { "text": "form.method = \"dialog\";", "role": "identifier" },
    { "text": "" },
    { "text": "// The clipboard is a promise, and wants a gesture behind it", "role": "comment" },
    { "text": "button.addEventListener(\"click\", async () => {", "role": "identifier" },
    { "text": "  try {", "role": "keyword" },
    { "text": "    await navigator.clipboard.writeText(box.returnValue);", "role": "identifier" },
    { "text": "    report(\"copied\");", "role": "identifier" },
    { "text": "  } catch (error) {", "role": "keyword" },
    { "text": "    warn(\"the clipboard was refused\");", "role": "identifier" },
    { "text": "  }", "role": "keyword" },
    { "text": "});", "role": "keyword" },
    { "text": "" },
    { "text": "// Reading asks the reader, writing after a click does not", "role": "comment" },
    { "text": "const text = await navigator.clipboard.readText();", "role": "identifier" },
    { "text": "" },
    { "text": "// Neither exists off a secure origin, so check for it", "role": "comment" },
    { "text": "if (!navigator.clipboard) {", "role": "keyword" },
    { "text": "  warn(\"no clipboard on this origin\");", "role": "identifier" },
    { "text": "}", "role": "keyword" }
  ]
}
