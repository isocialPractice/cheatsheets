{
  "title": "Fetch and Abort",
  "subtitle": "A request, its one readable body, and calling it off",
  "kind": "embed",
  "language": "javascript",
  "seed": "fetch-and-abort",
  "code": [
    { "text": "// A request resolves even when the server refused it", "role": "comment" },
    { "text": "const reply = await fetch(\"/api/items.json\");", "role": "identifier" },
    { "text": "if (!reply.ok) {", "role": "keyword" },
    { "text": "  throw new Error(`HTTP ${reply.status}`);", "role": "keyword" },
    { "text": "}", "role": "keyword" },
    { "text": "const items = await reply.json();", "role": "identifier" },
    { "text": "" },
    { "text": "// One body, one read: clone before the second reader", "role": "comment" },
    { "text": "const copy = reply.clone();", "role": "identifier" },
    { "text": "const raw = await copy.text();", "role": "identifier" },
    { "text": "" },
    { "text": "// A Request bundles the address with how to send it", "role": "comment" },
    { "text": "const post = new Request(\"/api/items\", {", "role": "identifier" },
    { "text": "  method: \"POST\",", "role": "identifier" },
    { "text": "  headers: { \"Content-Type\": \"application/json\" },", "role": "identifier" },
    { "text": "  body: JSON.stringify({ name: \"widget\" }),", "role": "identifier" },
    { "text": "});", "role": "keyword" },
    { "text": "" },
    { "text": "// AbortController is the only way to call a fetch off", "role": "comment" },
    { "text": "const stop = new AbortController();", "role": "identifier" },
    { "text": "setTimeout(() => stop.abort(), 5000);", "role": "identifier" },
    { "text": "" },
    { "text": "try {", "role": "keyword" },
    { "text": "  await fetch(\"/api/slow\", { signal: stop.signal });", "role": "identifier" },
    { "text": "} catch (error) {", "role": "keyword" },
    { "text": "  if (error.name === \"AbortError\") {", "role": "keyword" },
    { "text": "    report(\"the request was called off\");", "role": "identifier" },
    { "text": "  }", "role": "keyword" },
    { "text": "}", "role": "keyword" }
  ]
}
