  "title": "Web Storage",
  "subtitle": "Two string stores, and which one survives the tab",
  "kind": "embed",
  "language": "javascript",
  "seed": "web-storage",
  "code": [
    { "text": "// Both stores take strings only, and neither expires", "role": "comment" },
    { "text": "localStorage.setItem(\"theme\", \"dark\");", "role": "identifier" },
    { "text": "const theme = localStorage.getItem(\"theme\");", "role": "identifier" },
    { "text": "" },
    { "text": "// A missing key reads as null, not as the empty string", "role": "comment" },
    { "text": "if (localStorage.getItem(\"seat\") === null) {", "role": "keyword" },
    { "text": "  localStorage.setItem(\"seat\", \"aisle\");", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "// Anything structured goes through JSON both ways", "role": "comment" },
    { "text": "const basket = [", "role": "identifier" },
    { "text": "  \"apples\",", "role": "string" },
    { "text": "  \"flour\",", "role": "string" },
    { "text": "];", "role": "keyword" },
    { "text": "localStorage.setItem(\"basket\", JSON.stringify(basket));", "role": "identifier" },
    { "text": "const back = JSON.parse(localStorage.getItem(\"basket\"));", "role": "identifier" },
    { "text": "" },
    { "text": "// sessionStorage is emptied when the tab closes", "role": "comment" },
    { "text": "sessionStorage.setItem(\"step\", \"2\");", "role": "identifier" },
    { "text": "" },
    { "text": "// A full store throws rather than dropping the write", "role": "comment" },
    { "text": "try {", "role": "keyword" },
    { "text": "  localStorage.setItem(\"report\", big);", "role": "identifier" },
    { "text": "} catch (error) {", "role": "keyword" },
    { "text": "  warn(\"the store refused the write\");", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "// The event fires in other tabs, never in the writer", "role": "comment" },
    { "text": "addEventListener(\"storage\", (event) => {", "role": "identifier" },
    { "text": "  refresh(event.key);", "role": "identifier" },
    { "text": "});", "role": "keyword" }
  ]
