{
  "title": "Rounding and Precision",
  "subtitle": "Four ways down, one that lies",
  "kind": "run",
  "language": "javascript",
  "seed": "rounding-and-precision",
  "composition": "javascript-elements",
  "code": [
    { "text": "// Math.round goes to the nearest, and a half goes up, both signs", "role": "comment" },
    { "text": "console.log(Math.round(2.5)); // 3", "role": "identifier" },
    { "text": "console.log(Math.round(-2.5)); // -2", "role": "identifier" },
    { "text": "" },
    { "text": "// floor and ceil go one way whatever the sign", "role": "comment" },
    { "text": "console.log(Math.floor(-2.1)); // -3", "role": "identifier" },
    { "text": "console.log(Math.ceil(-2.9)); // -2", "role": "identifier" },
    { "text": "// trunc drops the fraction, which is not what floor does", "role": "comment" },
    { "text": "console.log(Math.trunc(-2.9)); // -2", "role": "identifier" },
    { "text": "" },
    { "text": "// A binary fraction does not land on a decimal one", "role": "comment" },
    { "text": "console.log(0.1 + 0.2); // 0.30000000000000004", "role": "identifier" },
    { "text": "console.log(0.1 + 0.2 === 0.3); // false", "role": "identifier" },
    { "text": "" },
    { "text": "// So the comparison is made against a tolerance", "role": "comment" },
    { "text": "const near = Math.abs(0.1 + 0.2 - 0.3) < Number.EPSILON;", "role": "identifier" },
    { "text": "console.log(near); // true", "role": "identifier" },
    { "text": "" },
    { "text": "// toFixed returns a string, and rounds the binary value behind it", "role": "comment" },
    { "text": "console.log((1.005).toFixed(2)); // 1.00", "role": "identifier" },
    { "text": "console.log(typeof (1.005).toFixed(2)); // string", "role": "identifier" },
    { "text": "" },
    { "text": "// NOTE scaling by a power of ten does not rescue it either", "role": "comment" },
    { "text": "console.log(Math.round(1.005 * 100) / 100); // 1", "role": "identifier" }
  ]
}
