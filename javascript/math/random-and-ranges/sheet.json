{
  "title": "Random and Ranges",
  "subtitle": "Scale it, floor it, bound it",
  "kind": "run",
  "language": "javascript",
  "seed": "random-and-ranges",
  "composition": "javascript-elements",
  "code": [
    { "text": "// Math.random is 0 inclusive to 1 exclusive, and takes no seed", "role": "comment" },
    { "text": "const roll = Math.random();", "role": "identifier" },
    { "text": "console.log(roll >= 0 && roll < 1); // true", "role": "identifier" },
    { "text": "" },
    { "text": "// Scale, then floor, for a whole number in a half open range", "role": "comment" },
    { "text": "const index = Math.floor(Math.random() * 5);", "role": "identifier" },
    { "text": "console.log(index >= 0 && index < 5); // true", "role": "identifier" },
    { "text": "" },
    { "text": "// An inclusive range needs the span plus one", "role": "comment" },
    { "text": "function between(low, high) {", "role": "keyword" },
    { "text": "  return low + Math.floor(Math.random() * (high - low + 1));", "role": "keyword" },
    { "text": "}", "role": "keyword" },
    { "text": "console.log(between(1, 6) >= 1); // true", "role": "identifier" },
    { "text": "" },
    { "text": "// min and max take any count of arguments, and spread a list", "role": "comment" },
    { "text": "const scores = [12, 7, 30, 4];", "role": "identifier" },
    { "text": "console.log(Math.max(...scores)); // 30", "role": "identifier" },
    { "text": "console.log(Math.min(...scores)); // 4", "role": "identifier" },
    { "text": "" },
    { "text": "// Given none they answer the identities, which are not zero", "role": "comment" },
    { "text": "console.log(Math.max()); // -Infinity", "role": "identifier" },
    { "text": "console.log(Math.min()); // Infinity", "role": "identifier" },
    { "text": "// Clamping is one call of each, innermost first", "role": "comment" },
    { "text": "console.log(Math.min(Math.max(42, 0), 10)); // 10", "role": "identifier" }
  ]
}
