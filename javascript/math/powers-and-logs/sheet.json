  "code": [
    { "text": "// ** is the operator form of Math.pow, and it binds rightwards", "role": "comment" },
    { "text": "console.log(2 ** 10); // 1024", "role": "identifier" },
    { "text": "console.log(2 ** 3 ** 2); // 512", "role": "identifier" },
    { "text": "" },
    { "text": "// sqrt is the square root; cbrt keeps its argument's sign", "role": "comment" },
    { "text": "console.log(Math.sqrt(144)); // 12", "role": "identifier" },
    { "text": "console.log(Math.cbrt(-27)); // -3", "role": "identifier" },
    { "text": "" },
    { "text": "// The root of a negative is NaN rather than a throw", "role": "comment" },
    { "text": "console.log(Math.sqrt(-1)); // NaN", "role": "identifier" },
    { "text": "// hypot squares, sums and roots without overflowing on the way", "role": "comment" },
    { "text": "console.log(Math.hypot(3, 4)); // 5", "role": "identifier" },
    { "text": "" },
    { "text": "// Math.log is the natural log, and that is the trap", "role": "comment" },
    { "text": "console.log(Math.log(100)); // 4.605170185988092", "role": "identifier" },
    { "text": "console.log(Math.log10(100)); // 2", "role": "identifier" },
    { "text": "" },
    { "text": "// log2 counts a bit width; a ratio of logs reaches any other base", "role": "comment" },
    { "text": "console.log(Math.log2(1024)); // 10", "role": "identifier" },
    { "text": "console.log(Math.log(81) / Math.log(3)); // 4.000000000000001", "role": "identifier" },
    { "text": "" },
    { "text": "// exp inverts the natural log, and e is a property of Math", "role": "comment" },
    { "text": "console.log(Math.exp(0)); // 1", "role": "identifier" },
    { "text": "console.log(Math.E.toFixed(3)); // 2.718", "role": "identifier" }
  ]
}
