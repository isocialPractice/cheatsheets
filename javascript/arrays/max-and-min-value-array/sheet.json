    { "text": "// FInd max and min in nested array.", "role": "comment" },
    { "text": "var ONE = [[1,2500], [[2, 50], [3, 33]], 8, 73, 1200];", "role": "identifier" },
    { "text": "/* 1. To string */  var one = ONE.toString();" },
    { "text": "/* 2. make array */ one = one.split(\",\");" },
    { "text": "/* 3. convert to number */ for (let i in one) one[i] = Number(one[i]);" },
    { "text": "/* 4. Now same logic */ one.sort(function(a, b) { return a - b;});" },
    { "text": "console.log(one[0]); // 1" },
    { "text": "// Use as function", "role": "comment" },
    { "text": "function unNestArray(arr) {", "role": "keyword" },
    { "text": " let tempArr = arr.toString();", "role": "identifier" },
    { "text": " tempArr = tempArr.split(\",\");" },
    { "text": " for (let i in tempArr) tempArr[i] = Number(tempArr[i]);" },
    { "text": " return tempArr; // could include sort function oupt max or min." },
    { "text": "}" },
    { "text": "var two = unNestArray(ONE);", "role": "identifier" },
    { "text": "two.sort(function(a, b) { return b - a; });" },
    { "text": "console.log(two[0]); // 2500" }
