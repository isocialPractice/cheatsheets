{
  "title": "Random Sort Array",
  "subtitle": "Shuffle by walking the array backwards",
  "kind": "run",
  "language": "javascript",
  "seed": "random-sort-array",
  "code": [
    { "text": "// NOTE - a “_” at the end of illustrations is final value at index.", "role": "comment" },
    { "text": "// NOTE - the count of “*” at end means matches prior iteration.", "role": "comment" },
    { "text": "var ONE = [40, 100, 1, 5, 25, 10];", "role": "identifier" },
    { "text": "var two = [...ONE];", "role": "identifier" },
    { "text": "function randomSort(x, y) {", "role": "keyword" },
    { "text": " for (let i = x.length-1; i > 0 ; i--) {", "role": "keyword" },
    { "text": "  let J = Math.floor(Math.random() * (i+1));", "role": "identifier" },
    { "text": "  let JIllustration = [0, 1, 0, 3, 2, 3]; // say j equates to this.", "role": "identifier" },
    { "text": "  let k = x[i];", "role": "identifier" },
    { "text": "  let k2= y[i];", "role": "identifier" },
    { "text": "  x[i] = x[J];" },
    { "text": "  y[i] = y[JIllustration[i]];" },
    { "text": "  // (i = 5) => x[5] = x[3] = 5_", "role": "comment" },
    { "text": "  // (i = 4) => x[4] = x[2] = 1  _", "role": "comment" },
    { "text": "  // (i = 3) => x[3] = x[3] = 10 _*", "role": "comment" },
    { "text": "  // (i = 2) => x[2] = x[0] = 40 _**", "role": "comment" },
    { "text": "  // (i = 1) => x[1] = x[1] = 100_***", "role": "comment" },
    { "text": "  // (i = 0) => x[0] = x[0] = 40", "role": "comment" },
    { "text": "" },
    { "text": "  x[J] = k;" },
    { "text": "  y[JIllustration[i]] = k2;" },
    { "text": "  // (j = 3) => x[3] = x[5] = 10  *", "role": "comment" },
    { "text": "  // (j = 2) => x[2] = x[4] = 25  **", "role": "comment" },
    { "text": "  // (j = 0) => x[0] = x[2] = 25 _**", "role": "comment" },
    { "text": "  // (j = 1) => x[1] = x[1] = 100 ***", "role": "comment" },
    { "text": " }" },
    { "text": "}" },
    { "text": "randomSort(ONE, two);" },
    { "text": "console.log(ONE); // r, a, n, s, e, q" },
    { "text": "console.log(\"Example output \" + two); // 25, 100, 40, 10, 1, 5" }
  ]
}
