  "code": [
    { "text": "var A = [1, 2500, 2, 50, 3, 33, 8, 73, 12];", "role": "identifier" },
    { "text": "function findMin(arr) { return Math.min.apply(null, arr); }", "role": "keyword" },
    { "text": "function findMax(arr) { return Math.max.apply(null, arr); }", "role": "keyword" },
    { "text": "var b = findMin(A); // 1", "role": "identifier" },
    { "text": "var c = findMax(A); // 2500", "role": "identifier" },
    { "text": "console.log(b); console.log(c);" },
    { "text": "" },
    { "text": "var B = [{i: \"c\", I: 3}, {i: \"b\", I: 1}, {i: \"a\", I: 2}];", "role": "identifier" },
    { "text": "B.sort( function(a, b) {  return a.I - b.I; });" },
    { "text": "console.log(B[0].I + \" \" + B[1].I + \" \" + B[2].I); // 1 2 3" },
    { "text": "// To sort by property with string.", "role": "comment" },
    { "text": "var cars = [", "role": "identifier" },
    { "text": " {type:\"Volvo\", year:2016}," },
    { "text": " {type:\"Saab\", year:2001}," },
    { "text": " {type:\"BMW\", year:2010}" },
    { "text": "];" },
    { "text": "cars.sort( function(a, b) {" },
    { "text": "   let x = a.type.toLowerCase();", "role": "identifier" },
    { "text": "   let y = b.type.toLowerCase();", "role": "identifier" },
    { "text": "   if (x < y) { return -1; }" },
    { "text": "   if (x > y) { return   1; }" },
    { "text": "   // else essentially", "role": "comment" },
    { "text": "    return 0;    });" },
    { "text": "console.log(cars); // BMW 2010, Saab 2001, Volvo 2016" },
    { "text": "for (let i in cars) { console.log(cars[i].type + \" \" + cars[i].year); }" },
    { "text": "// BMW 2010, Saab 2001, Volvo 2016", "role": "comment" }
  ]
}
