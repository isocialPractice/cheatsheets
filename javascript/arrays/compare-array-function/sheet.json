    { "text": " // a and b are equal; else essentially", "role": "comment" },
    { "text": " return 0;" },
    { "text": "});" },
    { "text": "console.log(d[0]); // {name: 'And', value: 45}" },
    { "text": "console.log(d[1]); // {name: 'Edward', value: 37}" },
