    { "text": "// ONE and all future array using spread syntax keep original.", "role": "comment" },
    { "text": "console.log(ONE); // (5) [3, 1, 4, 1, 5]" },
    { "text": "console.log(a); // (5) [1, 1, 3, 4, 5]" },
    { "text": "" },
