    { "text": "  { name: \"Edward\", value: 37 }," },
    { "text": "  { name: \"Sharpe\", value: 21 }," },
    { "text": "  { name: \"And\", value: 45 }" },
    { "text": "];" },
    { "text": "var c = [...THREE].sort((a, b) => a.value - b.value);", "role": "identifier" },
    { "text": "console.log(c[0]); // {name: 'Sharpe', value: 21}" },
