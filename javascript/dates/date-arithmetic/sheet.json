{
  "title": "Date Arithmetic",
  "subtitle": "Count in milliseconds, let the parts roll",
  "kind": "run",
  "language": "javascript",
  "seed": "date-arithmetic",
  "composition": "javascript-general",
  "code": [
    { "text": "// Subtracting one date from another gives milliseconds", "role": "comment" },
    { "text": "const start = new Date(Date.UTC(2026, 10, 21));", "role": "identifier" },
    { "text": "const end = new Date(Date.UTC(2026, 11, 25));", "role": "identifier" },
    { "text": "const day = 86400000;", "role": "identifier" },
    { "text": "" },
    { "text": "console.log(end - start); // 2937600000", "role": "identifier" },
    { "text": "console.log((end - start) / day); // 34", "role": "identifier" },
    { "text": "" },
    { "text": "// Adding is done to the count, then read back as a date", "role": "comment" },
    { "text": "const later = new Date(start.getTime() + 7 * day);", "role": "identifier" },
    { "text": "console.log(later.toISOString().slice(0, 10)); // 2026-11-28", "role": "identifier" },
    { "text": "" },
    { "text": "// A part out of range rolls over rather than failing", "role": "comment" },
    { "text": "const monthEnd = new Date(Date.UTC(2026, 11, 0));", "role": "identifier" },
    { "text": "console.log(monthEnd.toISOString().slice(0, 10)); // 2026-11-30", "role": "identifier" },
    { "text": "" },
    { "text": "// Day zero of next month is the last day of this one", "role": "comment" },
    { "text": "console.log(monthEnd.getUTCDate()); // 30", "role": "identifier" },
    { "text": "" },
    { "text": "// So adding a month can land on a day that never existed", "role": "comment" },
    { "text": "const jan31 = new Date(Date.UTC(2027, 0, 31));", "role": "identifier" },
    { "text": "jan31.setUTCMonth(1);", "role": "identifier" },
    { "text": "console.log(jan31.toISOString().slice(0, 10)); // 2027-03-03", "role": "identifier" },
    { "text": "" },
    { "text": "// NOTE February has 28 days in 2027, so the 31st rolls into March", "role": "comment" },
    { "text": "console.log(jan31.getUTCMonth()); // 2", "role": "identifier" }
  ]
}
