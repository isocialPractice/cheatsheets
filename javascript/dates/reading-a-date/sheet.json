{
  "title": "Reading a Date",
  "subtitle": "Every getter has a UTC twin",
  "kind": "run",
  "language": "javascript",
  "seed": "reading-a-date",
  "composition": "javascript-general",
  "code": [
    { "text": "// Every getter has a UTC twin, and the twin is the portable one", "role": "comment" },
    { "text": "const stamp = new Date(Date.UTC(2026, 10, 21, 9, 30, 15));", "role": "identifier" },
    { "text": "" },
    { "text": "console.log(stamp.getUTCFullYear()); // 2026", "role": "identifier" },
    { "text": "console.log(stamp.getUTCMonth()); // 10", "role": "identifier" },
    { "text": "console.log(stamp.getUTCDate()); // 21", "role": "identifier" },
    { "text": "console.log(stamp.getUTCDay()); // 6", "role": "identifier" },
    { "text": "" },
    { "text": "// NOTE November is month 10, and Saturday is day 6", "role": "comment" },
    { "text": "// A month counts from zero and a day of the month from one", "role": "comment" },
    { "text": "console.log(stamp.getUTCHours()); // 9", "role": "identifier" },
    { "text": "console.log(stamp.getUTCMinutes()); // 30", "role": "identifier" },
    { "text": "" },
    { "text": "// One format is the same wherever it is read", "role": "comment" },
    { "text": "console.log(stamp.toISOString()); // 2026-11-21T09:30:15.000Z", "role": "identifier" },
    { "text": "console.log(stamp.toISOString().slice(0, 10)); // 2026-11-21", "role": "identifier" },
    { "text": "" },
    { "text": "// getTime is the value, and all the rest is a rendering", "role": "comment" },
    { "text": "console.log(stamp.getTime()); // 1795253415000", "role": "identifier" },
    { "text": "console.log(Number(stamp)); // 1795253415000", "role": "identifier" },
    { "text": "" },
    { "text": "// A plain getter answers for whatever zone the reader is in", "role": "comment" },
    { "text": "// NOTE both lines below move with that zone, so neither claims a figure", "role": "comment" },
    { "text": "console.log(typeof stamp.getHours()); // number", "role": "identifier" },
    { "text": "console.log(typeof stamp.getTimezoneOffset()); // number", "role": "identifier" }
  ]
}
