{
  "title": "Making a Date",
  "subtitle": "Four ways in, and one that travels",
  "kind": "run",
  "language": "javascript",
  "seed": "making-a-date",
  "composition": "javascript-general",
  "code": [
    { "text": "// A date is a count of milliseconds from 1970 in UTC", "role": "comment" },
    { "text": "const epoch = new Date(0);", "role": "identifier" },
    { "text": "console.log(epoch.toISOString()); // 1970-01-01T00:00:00.000Z", "role": "identifier" },
    { "text": "" },
    { "text": "// Date.UTC builds that count, and a month counts from zero", "role": "comment" },
    { "text": "const launch = Date.UTC(2026, 10, 21);", "role": "identifier" },
    { "text": "console.log(launch); // 1795219200000", "role": "identifier" },
    { "text": "console.log(new Date(launch).toISOString()); // 2026-11-21T00:00:00.000Z", "role": "identifier" },
    { "text": "" },
    { "text": "// A string is parsed, and only the ISO form travels", "role": "comment" },
    { "text": "const parsed = new Date(\"2026-11-21T09:30:00.000Z\");", "role": "identifier" },
    { "text": "console.log(parsed.getTime()); // 1795253400000", "role": "identifier" },
    { "text": "" },
    { "text": "// The parts constructor reads its arguments as local time", "role": "comment" },
    { "text": "// NOTE the same call is a different instant in every zone", "role": "comment" },
    { "text": "const local = new Date(2026, 10, 21);", "role": "identifier" },
    { "text": "console.log(typeof local.getTime()); // number", "role": "identifier" },
    { "text": "" },
    { "text": "// A string nothing can parse is an Invalid Date, not a throw", "role": "comment" },
    { "text": "const bad = new Date(\"the 21st\");", "role": "identifier" },
    { "text": "console.log(Number.isNaN(bad.getTime())); // true", "role": "identifier" },
    { "text": "console.log(bad.toString()); // Invalid Date", "role": "identifier" },
    { "text": "" },
    { "text": "// Now is the one date that is never the same twice", "role": "comment" },
    { "text": "// NOTE Date.now gives the count, new Date() gives the object", "role": "comment" },
    { "text": "console.log(typeof Date.now()); // number", "role": "identifier" }
  ]
}
