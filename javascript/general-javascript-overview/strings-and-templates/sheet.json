  "composition": "javascript-general",
  "code": [
    { "text": "// A template reads better than a chain of plus signs", "role": "comment" },
    { "text": "const name = \"Jane Doe\";", "role": "identifier" },
    { "text": "const items = 3;", "role": "identifier" },
    { "text": "" },
    { "text": "console.log(`${name} has ${items} items`); // Jane Doe has 3 items", "role": "identifier" },
    { "text": "console.log(`${items} squared is ${items * items}`); // 3 squared is 9", "role": "identifier" },
    { "text": "" },
    { "text": "// A string is never changed, only read from", "role": "comment" },
    { "text": "const title = \"  Acme Corp  \";", "role": "identifier" },
    { "text": "console.log(title.trim()); // Acme Corp", "role": "identifier" },
    { "text": "console.log(title.length); // 13", "role": "identifier" },
    { "text": "" },
    { "text": "// Searching answers where, or answers whether", "role": "comment" },
    { "text": "console.log(name.indexOf(\"Doe\")); // 5", "role": "identifier" },
    { "text": "console.log(name.includes(\"Jane\")); // true", "role": "identifier" },
    { "text": "console.log(name.startsWith(\"J\")); // true", "role": "identifier" },
    { "text": "" },
    { "text": "// Slicing takes a half open range and counts back from the end", "role": "comment" },
    { "text": "console.log(name.slice(0, 4)); // Jane", "role": "identifier" },
    { "text": "console.log(name.slice(-3)); // Doe", "role": "identifier" },
    { "text": "" },
    { "text": "// Splitting and joining are each other's opposite", "role": "comment" },
    { "text": "const parts = name.split(\" \");", "role": "identifier" },
    { "text": "console.log(parts); // (2) ['Jane', 'Doe']", "role": "identifier" },
    { "text": "console.log(parts.join(\"-\")); // Jane-Doe", "role": "identifier" },
    { "text": "console.log(name.replace(\"Doe\", \"Smith\")); // Jane Smith", "role": "identifier" }
  ]
}
