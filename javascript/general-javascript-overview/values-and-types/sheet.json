{
  "title": "Values and Types",
  "subtitle": "Ask what a value is before trusting it",
  "kind": "run",
  "language": "javascript",
  "seed": "values-and-types",
  "composition": "javascript-general",
  "code": [
    { "text": "// A value has a type, and typeof is how you ask", "role": "comment" },
    { "text": "const total = 42;", "role": "identifier" },
    { "text": "const label = \"items\";", "role": "identifier" },
    { "text": "const ready = true;", "role": "identifier" },
    { "text": "const nothing = null;", "role": "identifier" },
    { "text": "let missing;", "role": "identifier" },
    { "text": "" },
    { "text": "console.log(typeof total); // number", "role": "identifier" },
    { "text": "console.log(typeof label); // string", "role": "identifier" },
    { "text": "console.log(typeof ready); // boolean", "role": "identifier" },
    { "text": "console.log(typeof missing); // undefined", "role": "identifier" },
    { "text": "" },
    { "text": "// NOTE null reports object, which is a bug kept for compatibility", "role": "comment" },
    { "text": "console.log(typeof nothing); // object", "role": "identifier" },
    { "text": "" },
    { "text": "// Every number is a double, so a tenth is not exact", "role": "comment" },
    { "text": "console.log(0.1 + 0.2); // 0.30000000000000004", "role": "identifier" },
    { "text": "const whole = Number.isInteger(total);", "role": "identifier" },
    { "text": "console.log(whole); // true", "role": "identifier" },
    { "text": "" },
    { "text": "// A conversion is either written down or done for you", "role": "comment" },
    { "text": "console.log(Number(\"42\") + 1); // 43", "role": "identifier" },
    { "text": "console.log(String(total) + 1); // 421", "role": "identifier" },
    { "text": "console.log(Boolean(\"\")); // false", "role": "identifier" },
    { "text": "console.log(Boolean(\"0\")); // true", "role": "identifier" }
  ]
}
