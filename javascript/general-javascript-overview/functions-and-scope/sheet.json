  "code": [
    { "text": "// A declaration is hoisted, so this call works above it", "role": "comment" },
    { "text": "console.log(double(4)); // 8", "role": "identifier" },
    { "text": "" },
    { "text": "function double(n) {", "role": "keyword" },
    { "text": "  return n * 2;", "role": "keyword" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "// An arrow is an expression, so it is assigned, not hoisted", "role": "comment" },
    { "text": "const triple = (n) => n * 3;", "role": "identifier" },
    { "text": "const greet = (name = \"Jane Doe\") => \"Hello, \" + name;", "role": "identifier" },
    { "text": "" },
    { "text": "console.log(triple(4)); // 12", "role": "identifier" },
    { "text": "console.log(greet()); // Hello, Jane Doe", "role": "identifier" },
    { "text": "" },
    { "text": "// A name declared with let belongs to its own block", "role": "comment" },
    { "text": "function counted() {", "role": "keyword" },
    { "text": "  let seen = \"outer\";", "role": "identifier" },
    { "text": "  if (true) {", "role": "keyword" },
    { "text": "    let seen = \"inner\";", "role": "identifier" },
    { "text": "    console.log(seen); // inner", "role": "identifier" },
    { "text": "  }", "role": "keyword" },
    { "text": "  return seen;", "role": "keyword" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "console.log(counted()); // outer", "role": "identifier" }
  ]
}
