{
  "title": "Destructuring",
  "subtitle": "Name the parts, copy the rest",
  "kind": "run",
  "language": "javascript",
  "seed": "destructuring-and-spread",
  "composition": "javascript-general",
  "code": [
    { "text": "// Destructuring names the parts of a value as you read it", "role": "comment" },
    { "text": "const order = { id: 7, customer: \"Jane Doe\", total: 42 };", "role": "identifier" },
    { "text": "const { customer, total } = order;", "role": "identifier" },
    { "text": "" },
    { "text": "console.log(customer); // Jane Doe", "role": "identifier" },
    { "text": "console.log(total); // 42", "role": "identifier" },
    { "text": "" },
    { "text": "// A default fills in for a key that is not there", "role": "comment" },
    { "text": "const { currency = \"USD\" } = order;", "role": "identifier" },
    { "text": "console.log(currency); // USD", "role": "identifier" },
    { "text": "" },
    { "text": "// An array destructures by position, and a hole is skipped", "role": "comment" },
    { "text": "const [first, , third] = [\"Acme Corp\", \"Contoso\", \"Northwind\"];", "role": "identifier" },
    { "text": "console.log(first); // Acme Corp", "role": "identifier" },
    { "text": "console.log(third); // Northwind", "role": "identifier" },
    { "text": "" },
    { "text": "// Spread copies one level, so the copy is shallow", "role": "comment" },
    { "text": "const amended = { ...order, total: 50 };", "role": "identifier" },
    { "text": "console.log(amended.total); // 50", "role": "identifier" },
    { "text": "console.log(order.total); // 42", "role": "identifier" },
    { "text": "" },
    { "text": "// Rest collects whatever the names ahead of it did not take", "role": "comment" },
    { "text": "const { id, ...rest } = order;", "role": "identifier" },
    { "text": "console.log(id); // 7", "role": "identifier" },
    { "text": "console.log(rest); // {customer: 'Jane Doe', total: 42}", "role": "identifier" }
  ]
}
