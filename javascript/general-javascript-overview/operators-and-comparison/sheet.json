{
  "title": "Comparing Values",
  "subtitle": "Three equals, and the falsy six",
  "kind": "run",
  "language": "javascript",
  "seed": "operators-and-comparison",
  "composition": "javascript-general",
  "code": [
    { "text": "// Strict equality compares the type as well as the value", "role": "comment" },
    { "text": "console.log(1 === 1); // true", "role": "identifier" },
    { "text": "console.log(1 === \"1\"); // false", "role": "identifier" },
    { "text": "console.log(1 == \"1\"); // true", "role": "identifier" },
    { "text": "" },
    { "text": "// NaN is the one value that is not equal to itself", "role": "comment" },
    { "text": "console.log(NaN === NaN); // false", "role": "identifier" },
    { "text": "const notNumber = Number.isNaN(NaN);", "role": "identifier" },
    { "text": "console.log(notNumber); // true", "role": "identifier" },
    { "text": "" },
    { "text": "// Or takes any falsy value, and zero is one of them", "role": "comment" },
    { "text": "const count = 0;", "role": "identifier" },
    { "text": "console.log(count || 10); // 10", "role": "identifier" },
    { "text": "console.log(count ?? 10); // 0", "role": "identifier" },
    { "text": "" },
    { "text": "// Optional chaining stops at the first missing link", "role": "comment" },
    { "text": "const order = { customer: { name: \"Jane Doe\" } };", "role": "identifier" },
    { "text": "console.log(order.customer?.name); // Jane Doe", "role": "identifier" },
    { "text": "console.log(order.payment?.card); // undefined", "role": "identifier" },
    { "text": "" },
    { "text": "// Plus joins strings, and every other operator counts", "role": "comment" },
    { "text": "console.log(\"3\" + 4); // 34", "role": "identifier" },
    { "text": "console.log(\"3\" - 4); // -1", "role": "identifier" },
    { "text": "console.log(7 % 3); // 1", "role": "identifier" },
    { "text": "console.log(2 ** 10); // 1024", "role": "identifier" }
  ]
}
