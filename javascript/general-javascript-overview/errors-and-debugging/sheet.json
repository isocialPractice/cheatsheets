{
  "title": "Errors and Debugging",
  "subtitle": "Throw, catch, or hand a value back",
  "kind": "run",
  "language": "javascript",
  "seed": "errors-and-debugging",
  "composition": "javascript-general",
  "code": [
    { "text": "// A throw abandons the function and looks for a catch", "role": "comment" },
    { "text": "function parse(text) {", "role": "keyword" },
    { "text": "  const found = Number(text);", "role": "identifier" },
    { "text": "  if (Number.isNaN(found)) {", "role": "keyword" },
    { "text": "    throw new TypeError(`${text} is not a number`);", "role": "keyword" },
    { "text": "  }", "role": "keyword" },
    { "text": "  return found;", "role": "keyword" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "console.log(parse(\"42\")); // 42", "role": "identifier" },
    { "text": "" },
    { "text": "// A catch is handed the error, and finally runs either way", "role": "comment" },
    { "text": "try {", "role": "keyword" },
    { "text": "  parse(\"ten\");", "role": "identifier" },
    { "text": "} catch (error) {", "role": "keyword" },
    { "text": "  console.log(error.name); // TypeError", "role": "identifier" },
    { "text": "  console.log(error.message); // ten is not a number", "role": "identifier" },
    { "text": "} finally {", "role": "keyword" },
    { "text": "  console.log(\"checked\"); // checked", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "// A guard hands a value back where a throw would stop the caller", "role": "comment" },
    { "text": "const safe = (text) => (text.trim() === \"\" ? 0 : parse(text));", "role": "identifier" },
    { "text": "console.log(safe(\"\")); // 0", "role": "identifier" },
    { "text": "console.log(safe(\"7\")); // 7", "role": "identifier" }
  ]
}
