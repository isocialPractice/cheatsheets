{
  "title": "Creating and Inserting",
  "subtitle": "Build it detached, attach it once",
  "kind": "embed",
  "language": "javascript",
  "seed": "creating-and-inserting",
  "composition": "javascript-elements",
  "code": [
    { "text": "// createElement makes a node that is in no document yet", "role": "comment" },
    { "text": "const row = document.createElement(\"li\");", "role": "identifier" },
    { "text": "row.textContent = \"Flour\";", "role": "identifier" },
    { "text": "" },
    { "text": "// append takes nodes and strings; appendChild takes one node", "role": "comment" },
    { "text": "const list = document.querySelector(\"#basket\");", "role": "identifier" },
    { "text": "list.append(row, \" 1 kg\");", "role": "identifier" },
    { "text": "" },
    { "text": "// A fragment carries a batch, so the page lays out once", "role": "comment" },
    { "text": "const batch = document.createDocumentFragment();", "role": "identifier" },
    { "text": "for (const name of [\"Apples\", \"Sugar\"]) {", "role": "keyword" },
    { "text": "  const item = document.createElement(\"li\");", "role": "identifier" },
    { "text": "  item.textContent = name;", "role": "identifier" },
    { "text": "  batch.append(item);", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "list.append(batch);", "role": "identifier" },
    { "text": "" },
    { "text": "// insertAdjacentHTML parses markup, so it takes no reader text", "role": "comment" },
    { "text": "row.insertAdjacentHTML(\"beforeend\", \"<em>on the list</em>\");", "role": "identifier" },
    { "text": "" },
    { "text": "// Appended a second time a node moves rather than copying", "role": "comment" },
    { "text": "list.prepend(row);", "role": "identifier" },
    { "text": "// And remove takes it out of the tree, still usable", "role": "comment" },
    { "text": "row.remove();", "role": "identifier" }
  ]
}
