{
  "title": "Measuring and Styling",
  "subtitle": "Read the box, write the token",
  "kind": "embed",
  "language": "javascript",
  "seed": "measuring-and-styling",
  "composition": "javascript-elements",
  "code": [
    { "text": "// A rect is in viewport coordinates, and fractional", "role": "comment" },
    { "text": "const panel = document.querySelector(\"#panel\");", "role": "identifier" },
    { "text": "const box = panel.getBoundingClientRect();", "role": "identifier" },
    { "text": "" },
    { "text": "// Its width carries padding and border, and any transform", "role": "comment" },
    { "text": "report(box.width);", "role": "identifier" },
    { "text": "report(box.top + window.scrollY);", "role": "identifier" },
    { "text": "" },
    { "text": "// offsetWidth rounds to an integer and ignores a transform", "role": "comment" },
    { "text": "report(panel.offsetWidth);", "role": "identifier" },
    { "text": "// style reads the inline attribute alone, so it is often empty", "role": "comment" },
    { "text": "report(panel.style.color);", "role": "identifier" },
    { "text": "" },
    { "text": "// getComputedStyle reads what the cascade resolved", "role": "comment" },
    { "text": "const used = getComputedStyle(panel);", "role": "identifier" },
    { "text": "report(used.color);", "role": "identifier" },
    { "text": "" },
    { "text": "// A custom property is read and written under its own name", "role": "comment" },
    { "text": "panel.style.setProperty(\"--gap\", \"8px\");", "role": "identifier" },
    { "text": "report(used.getPropertyValue(\"--gap\").trim());", "role": "identifier" },
    { "text": "" },
    { "text": "// Reading a box after writing one lays the page out again", "role": "comment" },
    { "text": "panel.style.width = box.width + 16 + \"px\";", "role": "identifier" },
    { "text": "report(panel.getBoundingClientRect().width);", "role": "identifier" }
  ]
}
