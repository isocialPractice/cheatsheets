{
  "title": "Attributes and Properties",
  "subtitle": "Two values, one element",
  "kind": "embed",
  "language": "javascript",
  "seed": "attributes-and-properties",
  "composition": "javascript-elements",
  "code": [
    { "text": "// An attribute is the markup; a property is the live value", "role": "comment" },
    { "text": "const box = document.querySelector(\"#terms\");", "role": "identifier" },
    { "text": "box.setAttribute(\"checked\", \"\");", "role": "identifier" },
    { "text": "" },
    { "text": "// The property moves when a reader clicks, the attribute does not", "role": "comment" },
    { "text": "box.checked = false;", "role": "identifier" },
    { "text": "" },
    { "text": "// getAttribute reads the markup back as a string, or null", "role": "comment" },
    { "text": "report(box.getAttribute(\"checked\"));", "role": "identifier" },
    { "text": "report(box.getAttribute(\"nothing\"));", "role": "identifier" },
    { "text": "" },
    { "text": "// A data-* attribute arrives on dataset, camel cased", "role": "comment" },
    { "text": "box.dataset.rowId = \"7\";", "role": "identifier" },
    { "text": "" },
    { "text": "// classList edits one class and leaves the rest of the list", "role": "comment" },
    { "text": "box.classList.toggle(\"is-open\", true);", "role": "identifier" },
    { "text": "" },
    { "text": "// A boolean attribute is present or absent, never \"false\"", "role": "comment" },
    { "text": "box.toggleAttribute(\"disabled\", true);", "role": "identifier" },
    { "text": "" },
    { "text": "// hidden, value and id are properties with attributes behind them", "role": "comment" },
    { "text": "box.hidden = true;", "role": "identifier" },
    { "text": "// An unknown property reaches the object and no markup at all", "role": "comment" },
    { "text": "box.rowCount = 3;", "role": "identifier" }
  ]
}
