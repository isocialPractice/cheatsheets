{
  "title": "Finding and Traversing",
  "subtitle": "One, many, and the way up",
  "kind": "embed",
  "language": "javascript",
  "seed": "finding-and-traversing",
  "composition": "javascript-elements",
  "code": [
    { "text": "// querySelector takes the first match in the tree, or null", "role": "comment" },
    { "text": "const form = document.querySelector(\"form.signup\");", "role": "identifier" },
    { "text": "" },
    { "text": "// querySelectorAll is a static list, so later nodes are not in it", "role": "comment" },
    { "text": "const fields = form.querySelectorAll(\"input, select\");", "role": "identifier" },
    { "text": "for (const field of fields) {", "role": "keyword" },
    { "text": "  mark(field);", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "// closest walks up through ancestors, the node itself included", "role": "comment" },
    { "text": "const row = fields[0].closest(\"[data-row]\");", "role": "identifier" },
    { "text": "// matches asks the same question of one node, without moving", "role": "comment" },
    { "text": "if (fields[0].matches(\":disabled\")) {", "role": "keyword" },
    { "text": "  skip(row);", "role": "identifier" },
    { "text": "}", "role": "keyword" },
    { "text": "" },
    { "text": "// children are elements; childNodes count text and comments too", "role": "comment" },
    { "text": "report(form.children.length);", "role": "identifier" },
    { "text": "report(form.childNodes.length);", "role": "identifier" },
    { "text": "" },
    { "text": "// parentElement stops at the document, parentNode does not", "role": "comment" },
    { "text": "report(form.parentElement.tagName);", "role": "identifier" },
    { "text": "// And a selector matching nothing is null, never a throw", "role": "comment" },
    { "text": "report(document.querySelector(\"#nowhere\"));", "role": "identifier" }
  ]
}
